import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine().trim());
        
        int startPos = 0, currentPetrol = 0, totalPetrol = 0;
        
        for (int i = 0; i < n; i++) {
            String[] row = br.readLine().split(" ");
            int petrol = Integer.parseInt(row[0]);
            int distance = Integer.parseInt(row[1]);
            
            int diff = petrol - distance;
            currentPetrol += diff;
            totalPetrol += diff;
            
            if (currentPetrol < 0) {
                startPos = i + 1;
                currentPetrol = 0;
            }
        }
        
        System.out.println(totalPetrol >= 0 ? startPos : -1);
    }
}
