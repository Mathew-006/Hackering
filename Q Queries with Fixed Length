import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String[] first = br.readLine().split(" ");
        int n = Integer.parseInt(first[0]);
        int q = Integer.parseInt(first[1]);
        
        int[] arr = new int[n];
        String[] elements = br.readLine().split(" ");
        for (int i = 0; i < n; i++) arr[i] = Integer.parseInt(elements[i]);
        
        StringBuilder sb = new StringBuilder();
        while (q-- > 0) {
            int d = Integer.parseInt(br.readLine().trim());
            int minOfMax = Integer.MAX_VALUE;
            int[] deque = new int[n];
            int head = 0, tail = 0;
            
            for (int i = 0; i < n; i++) {
                if (head < tail && deque[head] <= i - d) head++;
                while (head < tail && arr[deque[tail - 1]] <= arr[i]) tail--;
                deque[tail++] = i;
                if (i >= d - 1) minOfMax = Math.min(minOfMax, arr[deque[head]]);
            }
            sb.append(minOfMax).append("\n");
        }
        System.out.print(sb);
    }
}
