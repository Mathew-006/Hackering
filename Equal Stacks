import java.io.*;
import java.util.*;

public class Solution {

    public static int equalStacks(List<Integer> h1, List<Integer> h2, List<Integer> h3) {
        int s1 = 0, s2 = 0, s3 = 0;

        for (int height : h1) s1 += height;
        for (int height : h2) s2 += height;
        for (int height : h3) s3 += height;

        int i1 = 0, i2 = 0, i3 = 0;

        while (s1 != s2 || s2 != s3) {
            if (s1 >= s2 && s1 >= s3) {
                s1 -= h1.get(i1);
                i1++;
            } else if (s2 >= s1 && s2 >= s3) {
                s2 -= h2.get(i2);
                i2++;
            } else {
                s3 -= h3.get(i3);
                i3++;
            }

            if (s1 == 0 || s2 == 0 || s3 == 0) {
                return 0;
            }
        }

        return s1;
    }

    public static void main(String[] args) throws IOException {
        // Fixed: changed System.Stdin to System.in
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bufferedWriter = new BufferedWriter(new OutputStreamWriter(System.out));

        String[] sizes = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
        int n1 = Integer.parseInt(sizes[0]);
        int n2 = Integer.parseInt(sizes[1]);
        int n3 = Integer.parseInt(sizes[2]);

        String[] tokens1 = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
        List<Integer> h1 = new ArrayList<Integer>();
        for (int i = 0; i < n1; i++) {
            h1.add(Integer.parseInt(tokens1[i]));
        }

        String[] tokens2 = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
        List<Integer> h2 = new ArrayList<Integer>();
        for (int i = 0; i < n2; i++) {
            h2.add(Integer.parseInt(tokens2[i]));
        }

        String[] tokens3 = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
        List<Integer> h3 = new ArrayList<Integer>();
        for (int i = 0; i < n3; i++) {
            h3.add(Integer.parseInt(tokens3[i]));
        }

        int result = equalStacks(h1, h2, h3);

        bufferedWriter.write(String.valueOf(result));
        bufferedWriter.newLine();

        bufferedReader.close();
        bufferedWriter.close();
    }
}
